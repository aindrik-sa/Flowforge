# FlowForge — Environment Variables
# Copy this file to backend/.env and fill in your values.

# Django
SECRET_KEY=replace-this-with-a-random-secret-key
DEBUG=True

# Database (PostgreSQL)
DB_NAME=flowforge
DB_USER=flowforge
DB_PASSWORD=flowforge123
DB_HOST=localhost
DB_PORT=5433

# CORS (comma-separated origins, empty = none)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
